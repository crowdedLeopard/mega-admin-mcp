{
  "note": "Dataverse Web API operations most useful for Copilot Studio and Power Platform administration. Paths are relative to https://<org>.crm.dynamics.com/api/data/v9.2. Pass dataverse_org_url with invoke.",
  "operations": [
    {"svc": "dataverse", "m": "GET", "p": "/WhoAmI", "s": "Who am I in this environment (user id, business unit, organisation id)", "tags": ["identity"], "docs": "https://learn.microsoft.com/power-apps/developer/data-platform/webapi/reference/whoami"},
    {"svc": "dataverse", "m": "GET", "p": "/bots", "s": "List Copilot Studio agents (bot table): name, schema name, owner, authentication mode, published date, state", "tags": ["copilot-studio"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "name,botid,schemaname,publishedon,authenticationmode,statecode,_ownerid_value,configuration"}, {"n": "$filter", "in": "query", "req": false, "t": "string", "d": "OData filter"}, {"n": "$top", "in": "query", "req": false, "t": "integer", "d": ""}], "docs": "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/bot"},
    {"svc": "dataverse", "m": "GET", "p": "/bots({botid})", "s": "Get one Copilot Studio agent", "tags": ["copilot-studio"], "params": [{"n": "botid", "in": "path", "req": true, "t": "string", "d": "GUID"}]},
    {"svc": "dataverse", "m": "PATCH", "p": "/bots({botid})", "s": "Update an agent record (for example owner or settings)", "tags": ["copilot-studio"], "params": [{"n": "botid", "in": "path", "req": true, "t": "string", "d": "GUID"}], "body": "bot"},
    {"svc": "dataverse", "m": "GET", "p": "/botcomponents", "s": "List agent components (topics, knowledge sources, tools, triggers) across agents", "tags": ["copilot-studio"], "params": [{"n": "$filter", "in": "query", "req": false, "t": "string", "d": "e.g. _parentbotid_value eq <botid>"}, {"n": "$select", "in": "query", "req": false, "t": "string", "d": "name,componenttype,schemaname,statecode,_parentbotid_value"}], "docs": "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/botcomponent"},
    {"svc": "dataverse", "m": "GET", "p": "/botcomponentcollections", "s": "List agent component collections", "tags": ["copilot-studio"]},
    {"svc": "dataverse", "m": "GET", "p": "/aiplugins", "s": "List AI plugins (Copilot Studio tools / connector actions registered in the environment)", "tags": ["copilot-studio", "tools"]},
    {"svc": "dataverse", "m": "GET", "p": "/aipluginoperations", "s": "List AI plugin operations (individual tool operations)", "tags": ["copilot-studio", "tools"]},
    {"svc": "dataverse", "m": "GET", "p": "/conversationtranscripts", "s": "List Copilot Studio conversation transcripts (agent analytics raw data, 30 day retention by default)", "tags": ["copilot-studio", "analytics"], "params": [{"n": "$filter", "in": "query", "req": false, "t": "string", "d": "e.g. _bot_conversationtranscriptid_value eq <botid> and createdon ge 2026-10-01"}, {"n": "$top", "in": "query", "req": false, "t": "integer", "d": ""}]},
    {"svc": "dataverse", "m": "GET", "p": "/workflows", "s": "List processes including cloud flows (category eq 5), desktop flows (6), business process flows", "tags": ["power-automate"], "params": [{"n": "$filter", "in": "query", "req": false, "t": "string", "d": "category eq 5 and statecode eq 1"}, {"n": "$select", "in": "query", "req": false, "t": "string", "d": "name,workflowid,category,statecode,_ownerid_value,modifiedon,clientdata"}], "docs": "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/workflow"},
    {"svc": "dataverse", "m": "PATCH", "p": "/workflows({workflowid})", "s": "Turn a cloud flow on or off (statecode 1 = on, 0 = off) or change owner", "tags": ["power-automate"], "params": [{"n": "workflowid", "in": "path", "req": true, "t": "string", "d": "GUID"}], "body": "workflow"},
    {"svc": "dataverse", "m": "GET", "p": "/solutions", "s": "List solutions (managed and unmanaged) with publisher and version", "tags": ["alm"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "uniquename,friendlyname,version,ismanaged,installedon,_publisherid_value"}]},
    {"svc": "dataverse", "m": "GET", "p": "/solutioncomponents", "s": "List components in solutions", "tags": ["alm"]},
    {"svc": "dataverse", "m": "GET", "p": "/systemusers", "s": "List users in the environment (licence, access mode, disabled state, Entra object id)", "tags": ["users"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "fullname,domainname,azureactivedirectoryobjectid,isdisabled,accessmode,islicensed,applicationid"}, {"n": "$filter", "in": "query", "req": false, "t": "string", "d": "isdisabled eq false"}]},
    {"svc": "dataverse", "m": "GET", "p": "/systemusers({systemuserid})/systemuserroles_association", "s": "Security roles assigned to a user", "tags": ["users", "security"], "params": [{"n": "systemuserid", "in": "path", "req": true, "t": "string", "d": "GUID"}]},
    {"svc": "dataverse", "m": "POST", "p": "/systemusers({systemuserid})/systemuserroles_association/$ref", "s": "Assign a security role to a user", "tags": ["users", "security"], "params": [{"n": "systemuserid", "in": "path", "req": true, "t": "string", "d": "GUID"}], "body": "{\"@odata.id\": \"https://<org>.crm.dynamics.com/api/data/v9.2/roles(<roleid>)\"}"},
    {"svc": "dataverse", "m": "GET", "p": "/roles", "s": "List security roles", "tags": ["security"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "name,roleid,_businessunitid_value,ismanaged"}]},
    {"svc": "dataverse", "m": "GET", "p": "/teams", "s": "List teams (including Entra group teams)", "tags": ["security"]},
    {"svc": "dataverse", "m": "GET", "p": "/businessunits", "s": "List business units", "tags": ["security"]},
    {"svc": "dataverse", "m": "GET", "p": "/environmentvariabledefinitions", "s": "List environment variable definitions", "tags": ["alm"]},
    {"svc": "dataverse", "m": "GET", "p": "/environmentvariablevalues", "s": "List environment variable values", "tags": ["alm"]},
    {"svc": "dataverse", "m": "GET", "p": "/connectionreferences", "s": "List connection references (which connections flows and agents use)", "tags": ["alm", "connectors"]},
    {"svc": "dataverse", "m": "GET", "p": "/connectors", "s": "List custom connectors stored in Dataverse (solution-aware)", "tags": ["connectors"]},
    {"svc": "dataverse", "m": "GET", "p": "/appmodules", "s": "List model-driven apps", "tags": ["apps"]},
    {"svc": "dataverse", "m": "GET", "p": "/canvasapps", "s": "List canvas apps stored in Dataverse", "tags": ["apps"]},
    {"svc": "dataverse", "m": "GET", "p": "/organizations", "s": "Organisation settings (one row): features, limits, Copilot and AI settings, auditing, plugin trace level", "tags": ["settings"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "name,isauditenabled,plugintracelogsetting,powerappsmakerbotenabled,aipreviewsenabled,copilotfeatureflags"}]},
    {"svc": "dataverse", "m": "PATCH", "p": "/organizations({organizationid})", "s": "Change organisation settings (for example enable auditing)", "tags": ["settings"], "params": [{"n": "organizationid", "in": "path", "req": true, "t": "string", "d": "GUID from WhoAmI"}], "body": "organization"},
    {"svc": "dataverse", "m": "GET", "p": "/audits", "s": "Query the Dataverse audit log", "tags": ["audit"], "params": [{"n": "$filter", "in": "query", "req": false, "t": "string", "d": "createdon ge 2026-10-01T00:00:00Z"}, {"n": "$top", "in": "query", "req": false, "t": "integer", "d": ""}]},
    {"svc": "dataverse", "m": "GET", "p": "/msdyn_aimodels", "s": "List AI Builder models", "tags": ["ai-builder"]},
    {"svc": "dataverse", "m": "GET", "p": "/msdyn_aiconfigurations", "s": "List AI Builder model configurations (including prompts)", "tags": ["ai-builder"]},
    {"svc": "dataverse", "m": "GET", "p": "/EntityDefinitions", "s": "List tables (entity metadata)", "tags": ["metadata"], "params": [{"n": "$select", "in": "query", "req": false, "t": "string", "d": "LogicalName,EntitySetName,DisplayName,IsCustomEntity"}, {"n": "$filter", "in": "query", "req": false, "t": "string", "d": "IsCustomEntity eq true"}]},
    {"svc": "dataverse", "m": "GET", "p": "/EntityDefinitions(LogicalName='{logicalName}')", "s": "Describe one table including attributes", "tags": ["metadata"], "params": [{"n": "logicalName", "in": "path", "req": true, "t": "string", "d": "e.g. bot"}, {"n": "$expand", "in": "query", "req": false, "t": "string", "d": "Attributes($select=LogicalName,AttributeType)"}]},
    {"svc": "dataverse", "m": "GET", "p": "/RetrieveTotalRecordCount(EntityNames=['{logicalName}'])", "s": "Fast approximate row count for tables (capacity planning)", "tags": ["metadata", "capacity"], "params": [{"n": "logicalName", "in": "path", "req": true, "t": "string", "d": "e.g. conversationtranscript"}]},
    {"svc": "dataverse", "m": "GET", "p": "/RetrieveCurrentOrganization(AccessType=@p1)?@p1=Microsoft.Dynamics.CRM.EndpointAccessType'Default'", "s": "Current organisation detail (version, geo, state, endpoints)", "tags": ["settings"]},
    {"svc": "dataverse", "m": "POST", "p": "/$batch", "s": "Batch multiple Dataverse requests", "tags": ["batch"], "body": "multipart/mixed"}
  ]
}
