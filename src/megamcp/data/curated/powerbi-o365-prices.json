    {"svc": "powerbi", "m": "GET", "p": "/v1.0/myorg/admin/datasets", "s": "List all semantic models (admin)", "tags": ["admin"], "params": [{"n": "$top", "in": "query", "req": false, "t": "integer", "d": ""}]},
