    {"svc": "o365mgmt", "m": "GET", "p": "/api/v1.0/{tenantId}/activity/feed/subscriptions/content", "s": "List available audit content blobs for a content type and time window (then GET each contentUri)", "tags": ["audit"], "params": [{"n": "tenantId", "in": "path", "req": true, "t": "string", "d": ""}, {"n": "contentType", "in": "query", "req": true, "t": "string", "d": "Audit.General includes Copilot interactions"}, {"n": "startTime", "in": "query", "req": false, "t": "string", "d": "YYYY-MM-DDTHH:MM"}, {"n": "endTime", "in": "query", "req": false, "t": "string", "d": "max 24h window, within last 7 days"}]},
    {"svc": "retailprices", "m": "GET", "p": "/api/retail/prices", "s": "Azure retail prices for any meter. Filter with OData: serviceName eq 'Azure OpenAI' and armRegionName eq 'uksouth' and contains(skuName,'gpt 4o'). Public, no token.", "tags": ["prices", "finops"], "params": [{"n": "$filter", "in": "query", "req": false, "t": "string", "d": "OData filter on serviceName, productName, skuName, meterName, armRegionName, priceType, serviceFamily"}, {"n": "currencyCode", "in": "query", "req": false, "t": "string", "d": "USD, EUR, GBP ..."}, {"n": "api-version", "in": "query", "req": false, "t": "string", "d": "2023-01-01-preview for savings plan prices"}], "docs": "https://learn.microsoft.com/rest/api/cost-management/retail-prices/azure-retail-prices"}
