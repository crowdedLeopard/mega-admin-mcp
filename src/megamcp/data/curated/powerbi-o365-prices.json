    {"svc": "powerbi", "m": "POST", "p": "/v1.0/myorg/admin/workspaces/getInfo", "s": "Scanner API: start a metadata scan for up to 100 workspaces", "tags": ["admin", "scanner"], "params": [{"n": "lineage", "in": "query", "req": false, "t": "boolean", "d": ""}, {"n": "datasourceDetails", "in": "query", "req": false, "t": "boolean", "d": ""}, {"n": "datasetSchema", "in": "query", "req": false, "t": "boolean", "d": ""}], "body": "{\"workspaces\": [\"<id>\"]}", "docs": "https://learn.microsoft.com/rest/api/power-bi/admin/workspace-info-post-workspace-info"},
