    {"svc": "powerbi", "m": "GET", "p": "/v1.0/myorg/admin/workspaces/scanResult/{scanId}", "s": "Scanner API: scan result", "tags": ["admin", "scanner"], "params": [{"n": "scanId", "in": "path", "req": true, "t": "string", "d": ""}]},
