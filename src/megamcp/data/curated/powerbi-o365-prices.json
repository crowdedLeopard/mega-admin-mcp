    {"svc": "powerbi", "m": "GET", "p": "/v1.0/myorg/admin/activityevents", "s": "Audit activity events for one day (admin), paged with continuationUri", "tags": ["admin", "audit"], "params": [{"n": "startDateTime", "in": "query", "req": true, "t": "string", "d": "'2026-10-22T00:00:00.000Z' (quoted)"}, {"n": "endDateTime", "in": "query", "req": true, "t": "string", "d": "'2026-10-22T23:59:59.999Z' same day"}, {"n": "$filter", "in": "query", "req": false, "t": "string", "d": "Activity eq 'ViewReport'"}], "docs": "https://learn.microsoft.com/rest/api/power-bi/admin/get-activity-events"},
